<Window x:Class="SI360.GateRunner.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="GateRunner Settings"
        Width="940"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,10"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>
        <Style x:Key="FieldBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SmallFieldBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldBoxStyle}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#D7E9FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#BFDFFF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="itemBorder" Property="Background" Value="#F2F2F2"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#D7E9FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFDFFF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F2F2F2"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#9CA3AF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Black" VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Configure paths, test execution, FlaUI, reports, and runtime readiness inputs."
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Use Detected Values"
                    MinWidth="170"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="UseDetectedValues_Click"
                    AutomationProperties.Name="Use detected settings values"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>
                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Runner Paths" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Detected values come from the saved settings, SI360 solution root, and local defaults."
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Solution path" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="SolutionPathBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     AutomationProperties.Name="Solution path"/>

                            <TextBlock Grid.Row="1" Text="Test project path" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TestProjectPathBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     AutomationProperties.Name="Test project path"/>

                            <TextBlock Grid.Row="2" Text="Results directory" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="ResultsDirectoryBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     AutomationProperties.Name="Results directory"/>

                            <TextBlock Grid.Row="3" Text="Build configuration" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="BuildConfigurationBox" Grid.Row="3" Grid.Column="1" Width="160" HorizontalAlignment="Left" Style="{StaticResource FieldBoxStyle}"
                                     AutomationProperties.Name="Build configuration"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="FlaUI Execution" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Used by the FlaUI Scenario Matrix when it launches SI360 UI tests."
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="FlaUI test project" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="FlaUiTestProjectPathBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     AutomationProperties.Name="FlaUI test project path"/>

                            <TextBlock Grid.Row="1" Text="SI360 UI app" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="Si360UiAppPathBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     AutomationProperties.Name="SI360 UI app path"/>

                            <TextBlock Grid.Row="2" Text="SI360 valid PIN" Style="{StaticResource FieldLabelStyle}"/>
                            <PasswordBox x:Name="Si360UiValidPinBox" Grid.Row="2" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10"
                                         AutomationProperties.Name="SI360 UI valid PIN"/>

                            <TextBlock Grid.Row="3" Text="Per-test timeout" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="PerTestTimeoutBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource SmallFieldBoxStyle}"
                                     AutomationProperties.Name="Per-test timeout seconds"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Build And Gate Timeouts" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Restore timeout" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RestoreTimeoutBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource SmallFieldBoxStyle}"
                                     AutomationProperties.Name="Restore timeout seconds"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Build timeout" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="BuildTimeoutBox" Grid.Row="0" Grid.Column="3" Style="{StaticResource SmallFieldBoxStyle}"
                                     AutomationProperties.Name="Build timeout seconds"/>

                            <TextBlock Grid.Row="1" Text="Gate timeout" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="GateTimeoutBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource SmallFieldBoxStyle}"
                                     AutomationProperties.Name="Gate timeout seconds"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Runtime Readiness" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Metadata and probes feed the Metadata and Probes tabs plus the GO/HOLD/NO-GO decision."
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Metadata path" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="DeploymentMetadataPathBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     AutomationProperties.Name="Deployment metadata path"/>

                            <TextBlock Grid.Row="1" Text="Probe settings" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <ComboBox x:Name="ProbeModeBox" Width="160" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="Probe mode">
                                    <sys:String>Disabled</sys:String>
                                    <sys:String>ReadOnly</sys:String>
                                    <sys:String>Active</sys:String>
                                </ComboBox>
                                <TextBlock Text="Timeout" VerticalAlignment="Center" Margin="24,0,12,0" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBox x:Name="ProbeTimeoutBox" Style="{StaticResource SmallFieldBoxStyle}" Margin="0"
                                         AutomationProperties.Name="Probe timeout seconds"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Reports And Bundles" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Leave support bundle path blank to generate timestamped bundles in the results directory."
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Retention days" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RetentionDaysBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource SmallFieldBoxStyle}"
                                     AutomationProperties.Name="Report retention days"/>

                            <TextBlock Grid.Row="1" Text="Support bundle path" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="SupportBundleOutputPathBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     AutomationProperties.Name="Support bundle output path"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText"
                       Foreground="{DynamicResource DangerRedBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" MinWidth="120" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"
                        AutomationProperties.Name="Cancel settings"/>
                <Button Content="Save" MinWidth="120" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="Save_Click" AutomationProperties.Name="Save settings"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
