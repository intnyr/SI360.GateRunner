<UserControl x:Class="SI360.GateRunner.Views.TestScenarioMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SI360.GateRunner.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TestScenarioMatrixViewModel}"
             mc:Ignorable="d"
             AutomationProperties.Name="Unit integration repository and service test scenario matrix">
    <UserControl.Resources>
        <Style x:Key="MatrixActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="64"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="MatrixTypeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnit}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsService}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRepository}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIntegration}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MatrixStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="NotRun">
                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Queued">
                    <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerRedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Blocked">
                    <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NotImplemented">
                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,16,0"
                    MaxHeight="112"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,8"
                              AutomationProperties.Name="Scrollable test scenario matrix details">
                    <StackPanel>
                        <TextBlock Text="Test Scenario Matrix" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding RunStatusText}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SourcePathText}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="{Binding LoadErrorText}" Foreground="{DynamicResource DangerRedBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadErrors}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Run All"
                        Style="{StaticResource MatrixActionButtonStyle}"
                        Command="{Binding RunAllCommand}"
                        AutomationProperties.Name="Run all mapped test scenario matrix rows"/>
                <Button Content="Run Filtered"
                        Style="{StaticResource MatrixActionButtonStyle}"
                        Command="{Binding RunFilteredCommand}"
                        AutomationProperties.Name="Run filtered test scenario matrix rows"/>
                <Button Content="Run Selected"
                        Style="{StaticResource MatrixActionButtonStyle}"
                        Command="{Binding RunSelectedCommand}"
                        AutomationProperties.Name="Run selected test scenario matrix row"/>
                <Button Content="Refresh"
                        Style="{StaticResource MatrixActionButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh test scenario matrix"/>
                <Button Content="Open Source"
                        Style="{StaticResource MatrixActionButtonStyle}"
                        Command="{Binding OpenSourceDocumentCommand}"
                        AutomationProperties.Name="Open test scenario matrix source document"/>
                <Button Content="Copy Markdown"
                        Style="{StaticResource MatrixActionButtonStyle}"
                        Command="{Binding CopySelectedMarkdownCommand}"
                        AutomationProperties.Name="Copy selected test scenario matrix row as Markdown"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search test scenario matrix"
                     ToolTip="Search area, scenario, type, setup, expected result, target code, and notes"/>
            <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowUnit}" Content="Unit"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowService}" Content="Service"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowRepository}" Content="Repository"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowIntegration}" Content="Integration"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowStatic}" Content="Static"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowOther}" Content="Other"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360"/>
                <ColumnDefinition Width="2*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      ColumnWidth="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Unit integration repository and service test scenario grid">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" Padding="10,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" MinWidth="150" Width="Auto" CanUserResize="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusLabel}"
                                           Style="{StaticResource MatrixStatusTextStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FailureDetails}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Area" Binding="{Binding Area}" MinWidth="220" Width="Auto"/>
                    <DataGridTextColumn Header="Specific Test Scenario" Binding="{Binding Scenario}" MinWidth="260" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Scenario}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Recommended Test Type" MinWidth="180" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RecommendedTestType}"
                                           Style="{StaticResource MatrixTypeTextStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RecommendedTestType}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mapped Test" Binding="{Binding MappedTestFilter}" MinWidth="240" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding MappedTestFilter}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Setup / Inputs" Binding="{Binding SetupInputs}" MinWidth="260" Width="Auto"/>
                    <DataGridTextColumn Header="Expected Result" Binding="{Binding ExpectedResult}" MinWidth="280" Width="Auto"/>
                    <DataGridTextColumn Header="Suggested Target Code" Binding="{Binding SuggestedTargetCode}" MinWidth="240" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding SuggestedTargetCode}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" MinWidth="260" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    AutomationProperties.Name="Test scenario matrix detail">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedItem}">
                        <TextBlock Text="{Binding Scenario, FallbackValue='Select a test scenario'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Area}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="Recommended Test Type" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecommendedTestType}" Style="{StaticResource MatrixTypeTextStyle}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Status" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource MatrixStatusTextStyle}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Mapped Test" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MappedTestFilter}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Setup / Inputs" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SetupInputs}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Expected Result" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ExpectedResult}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Suggested Target Code" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SuggestedTargetCode}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="Failure Details" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding FailureDetails}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="TRX" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding TrxPath}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
