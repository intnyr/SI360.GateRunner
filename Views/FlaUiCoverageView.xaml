<UserControl x:Class="SI360.GateRunner.Views.FlaUiCoverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SI360.GateRunner.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:FlaUiCoverageViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="FlaUI coverage gate list">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Run All"
                        MinHeight="34"
                        Padding="14,0"
                        FontSize="13"
                        Command="{Binding RunAllCoverageCommand}"
                        AutomationProperties.Name="Run all mapped FlaUI coverage scenarios"/>
                <Button Content="Run Filtered"
                        MinHeight="34"
                        Padding="14,0"
                        FontSize="13"
                        Margin="8,0,0,0"
                        Command="{Binding RunFilteredCoverageCommand}"
                        AutomationProperties.Name="Run filtered FlaUI coverage scenarios"/>
                <Button Content="Run Selected"
                        MinHeight="34"
                        Padding="14,0"
                        FontSize="13"
                        Margin="8,0,0,0"
                        Command="{Binding RunSelectedCoverageCommand}"
                        AutomationProperties.Name="Run selected FlaUI coverage scenario"/>
                <Button Content="Cancel"
                        MinHeight="34"
                        Padding="14,0"
                        FontSize="13"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCoverageRunCommand}"
                        AutomationProperties.Name="Cancel FlaUI coverage run"/>
                <Button Content="Refresh"
                        MinHeight="34"
                        Padding="14,0"
                        FontSize="13"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh FlaUI coverage"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="FlaUI Coverage" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                           AutomationProperties.Name="FlaUI coverage summary"/>
                <TextBlock Text="{Binding RunStatusText}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                           AutomationProperties.Name="FlaUI coverage run status"/>
                <TextBlock Text="{Binding LoadErrorText}" Foreground="{DynamicResource DangerRedBrush}" TextWrapping="Wrap"
                           AutomationProperties.Name="FlaUI coverage load errors">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoadErrors}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search FlaUI coverage"
                     ToolTip="Search scenarios, tests, source files, notes, evidence, and blocker text"/>
            <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowOrderTaking}" Content="Order Taking"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowUserFunctions}" Content="User Functions"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowPassed}" Content="Passed"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowFailed}" Content="Failed"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowBlocked}" Content="Blocked"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowNeedsReview}" Content="Needs Review"/>
                <ToggleButton Style="{StaticResource ChipToggleStyle}" IsChecked="{Binding ShowNotStarted}" Content="Not Started"/>
            </WrapPanel>
        </Grid>

        <DataGrid Grid.Row="2"
                  Grid.Column="0"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="FlaUI coverage scenario checklist">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAltBrush}" Padding="10,6">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Scenario" Binding="{Binding Scenario}" MinWidth="260" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Scenario}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Automation" Binding="{Binding Automation}" Width="140"/>
                <DataGridTextColumn Header="Execution" Binding="{Binding Execution}" Width="120"/>
                <DataGridTextColumn Header="Evidence" Binding="{Binding HasEvidence}" Width="90"/>
                <DataGridTextColumn Header="Latest Test" Binding="{Binding LatestTest}" MinWidth="260" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding LatestTest}"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Grid.Column="1" Margin="12,0,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                AutomationProperties.Name="FlaUI coverage scenario detail">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Open Evidence" MinHeight="34" Padding="12,0" FontSize="13"
                            Command="{Binding OpenSelectedEvidenceCommand}"
                            AutomationProperties.Name="Open selected FlaUI evidence"/>
                    <Button Content="Copy Markdown" MinHeight="34" Padding="12,0" FontSize="13" Margin="8,0,0,0"
                            Command="{Binding CopySelectedMarkdownCommand}"
                            AutomationProperties.Name="Copy selected FlaUI scenario as Markdown"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedItem}">
                        <TextBlock Text="{Binding Scenario, FallbackValue='Select a FlaUI scenario'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Group}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <TextBlock Text="Status" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                            <TextBlock Text="Automation" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Automation}" TextWrapping="Wrap"/>
                            <TextBlock Text="Execution" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Execution}" TextWrapping="Wrap"/>
                            <TextBlock Text="Verification" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding VerificationLevel}" TextWrapping="Wrap"/>
                        </UniformGrid>
                        <TextBlock Text="Latest Test" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LatestTest}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Source Files" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SourceFiles}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Evidence" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Evidence}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Blocker" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Blocker}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Error" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
